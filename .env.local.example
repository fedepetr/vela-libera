# Copia questo file in .env.local e inserisci i valori dal tuo progetto Supabase
# (Supabase Dashboard -> Project Settings -> API)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=la-tua-anon-key

# Numero WhatsApp per il contatto rapido (formato internazionale, senza + o spazi)
NEXT_PUBLIC_WHATSAPP_NUMBER=391234567890
